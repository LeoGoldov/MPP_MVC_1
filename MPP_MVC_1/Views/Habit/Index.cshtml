@model IEnumerable<MPP_MVC_1.Models.Habit>
@{
    ViewData["Title"] = "Мои привычки";
}

<h1>Мои привычки</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Создать привычку</a>
</p>

@if (!Model.Any())
{
        <div class="alert alert-info">
            У вас пока нет привычек. Создайте первую привычку!
        </div>
}
else
{
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Описание</th>
                    <th>Сложность</th>
                    <th>Статус</th>
                    <th>Прогресс</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var habit in Model)
            {
                        <tr>
                            <td style="border-left: 5px solid #@habit.Color; padding-left: 10px;">
                                <strong>@habit.Title</strong>
                            </td>
                            <td>@(habit.Description?.Length > 50 ? habit.Description.Substring(0, 50) + "..." : habit.Description)</td>
                            <td>
                        @switch (habit.Difficulty)
                        {
                            case Difficulty.Easy:
                                                <span class="badge bg-success">Лёгкая</span>
                                break;
                            case Difficulty.Medium:
                                                <span class="badge bg-warning">Средняя</span>
                                break;
                            case Difficulty.Hard:
                                                <span class="badge bg-danger">Сложная</span>
                                break;
                        }
                            </td>
                            <td>
                        @if (habit.IsArchived)
                        {
                                        <span class="badge bg-secondary">В архиве</span>
                        }
                        else
                        {
                                        <span class="badge bg-success">Активна</span>
                        }
                            </td>
                            <td>
                        @{
                            var total = habit.Logs.Count;
                            var completed = habit.Logs.Count(l => l.IsCompleted);
                            var percent = total > 0 ? (completed * 100 / total) : 0;
                        }
                                <div class="progress" style="height: 20px;">
                                    <div class="progress-bar bg-success" 
                                         role="progressbar" 
                                         style="width: @percent%;" 
                                         aria-valuenow="@percent" 
                                         aria-valuemin="0" 
                                         aria-valuemax="100">
                                @percent%
                                    </div>
                                </div>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@habit.Id" class="btn btn-sm btn-info">Детали</a>
                                <a asp-action="Edit" asp-route-id="@habit.Id" class="btn btn-sm btn-warning">Изменить</a>
                                <form asp-action="Delete" asp-route-id="@habit.Id" method="post" style="display:inline">
                            @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Удалить привычку «@habit.Title»?')">Удалить</button>
                                </form>
                            </td>
                        </tr>
            }
            </tbody>
        </table>
}