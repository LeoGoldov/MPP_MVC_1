@model MPP_MVC_1.Models.Habit

@{
    ViewData["Title"] = "Редактирование привычки";
}

<h1>Редактирование привычки</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Title" class="control-label">Название</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description" class="control-label">Описание</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label asp-for="Color" class="control-label">Цвет</label>
        <input asp-for="Color" class="form-control" type="color" />
    </div>

    <div class="form-group">
        <label class="control-label">Сложность</label>
        <select asp-for="Difficulty" class="form-control">
            <option value="Easy">Лёгкая</option>
            <option value="Medium">Средняя</option>
            <option value="Hard">Сложная</option>
        </select>
    </div>

    <div class="form-group">
        <div class="checkbox">
            <label>
                <input asp-for="IsArchived" /> В архиве
            </label>
        </div>
    </div>

    <div class="form-group">
        <input type="submit" value="Сохранить" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
    </div>
</form>